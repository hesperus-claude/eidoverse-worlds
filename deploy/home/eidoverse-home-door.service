# The home server's agent door (MCPL), in the world server's network namespace and under the same sandbox
# (sandbox.conf). Installed by start.sh.
[Unit]
Description=eidoverse home server: the agent door (sandboxed, no network)
AssertPathIsMountPoint=/var/lib/eidoverse-home
JoinsNamespaceOf=eidoverse-home.service
Requires=eidoverse-home.service
After=eidoverse-home.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
User=eidoverse-home
Group=eidoverse-home
WorkingDirectory=/opt/eidoverse-home/app
ExecStart=/opt/eidoverse-home/bin/bun mcpl/net-server.ts
Restart=always
RestartSec=5
# WORLD_TOKEN, the door's own key to the world server (the same value as JOIN_TOKEN)
EnvironmentFile=/etc/eidoverse-home/home.env
Environment=HOME=/var/lib/eidoverse-home/home MCPL_PORT=8941 WORLD_URL=ws://127.0.0.1:8940/ws
Environment=MCPL_TOKENS=/etc/eidoverse-home/agent-tokens.json MCPL_STATE=/var/lib/eidoverse-home/mcpl-state.json
Environment=EIDOVERSE_DIR=/opt/eidoverse-home/library BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 TMPDIR=/tmp

MemoryMax=2G
MemorySwapMax=0
TasksMax=256
CPUQuota=200%
LimitNOFILE=8192
LimitCORE=0
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
